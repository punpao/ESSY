# Development Environment Variables
# Copy this to .env for local development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/escrow

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=dev_secret_change_in_production
NEXTAUTH_SECRET=dev_nextauth_secret_change_in_production

# LINE Login OAuth (use demo values or register at https://developers.line.biz/)
LINE_CHANNEL_ID=demo
LINE_CHANNEL_SECRET=demo
LINE_CALLBACK_URL=http://localhost:3000/api/auth/callback/line

# App URLs
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Payment
PAYMENT_WEBHOOK_SECRET=mock_secret_for_development

# Escrow Settings
AUTO_RELEASE_HOURS=48

# Node Environment
NODE_ENV=development
