{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx src/worker/index.ts",
    "postinstall": "prisma generate --schema ../../infra/prisma/schema.prisma"
  },
  "dependencies": {
    "@escrow/core": "workspace:*",
    "@escrow/payment": "workspace:*",
    "@fastify/cors": "^9.0.1",
    "@fastify/formbody": "^7.4.0",
    "@fastify/jwt": "^8.0.1",
    "@fastify/sensible": "^6.0.1",
    "@prisma/client": "^5.14.0",
    "bullmq": "^5.7.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.26.0",
    "fastify-type-provider-zod": "^3.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.0.0",
    "ulid": "^2.3.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "@types/uuid": "^9.0.7",
    "pino-pretty": "^11.2.2",
    "prisma": "^5.14.0",
    "tsx": "^4.7.0"
  }
}
