{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --dts --format esm,cjs --out-dir dist",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "prisma": "prisma",
    "prisma:generate": "prisma generate --schema ../../infra/prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^9.3.0",
    "@fastify/sensible": "^5.6.0",
    "@fastify/formbody": "^7.4.0",
    "@fastify/static": "^6.12.0",
    "@prisma/client": "^5.18.0",
    "bullmq": "^4.17.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.0",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^5.4.2",
    "pino": "^8.17.0",
    "ulid": "^2.3.0",
    "zod": "^3.23.8",
    "@thai-escrow/core": "workspace:*",
    "@thai-escrow/payment": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^5.18.0",
    "tsup": "^8.0.1",
    "tsx": "^4.15.7",
    "vitest": "^1.5.0"
  },
  "prisma": {
    "schema": "../../infra/prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  }
}
