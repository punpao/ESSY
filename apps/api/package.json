{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.0",
    "@fastify/formbody": "^7.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.0.0",
    "@prisma/client": "^5.14.0",
    "bullmq": "^4.10.0",
    "dayjs": "^1.11.10",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.2",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^5.3.2",
    "node-fetch": "^3.3.2",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "prisma": "^5.14.0",
    "ulid": "^2.3.0",
    "zod": "^3.23.0",
    "@thai-social-escrow/core": "workspace:*",
    "@thai-social-escrow/payment": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.25",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.1"
  }
}
