{
  "name": "@thai-escrow/api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file ../../.env.local src/server.ts",
    "build": "tsup src/server.ts src/worker.ts --format esm --dts false --out-dir dist",
    "start": "node dist/server.js",
    "worker": "tsx --env-file ../../.env.local src/worker.ts",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.4.0",
    "@fastify/jwt": "^8.3.0",
    "@fastify/sensible": "^6.0.1",
    "@prisma/client": "^5.16.1",
    "@thai-escrow/core": "workspace:*",
    "@thai-escrow/payment": "workspace:*",
    "bullmq": "^5.7.15",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fastify-type-provider-zod": "^3.7.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.7",
    "pino": "^9.3.2",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/pino": "^8.12.3",
    "prisma": "^5.16.1",
    "tsup": "^8.1.0",
    "tsx": "^4.10.3",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
