generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  role         String   @default("buyer") // 'buyer' | 'seller' | 'admin'
  line_sub     String?  @unique
  email        String?  @unique
  phone        String?
  kyc_level    String   @default("none") // 'none' | 'basic' | 'full'
  display_name String
  created_at   DateTime @default(now())

  seller_profile SellerProfile?
  deals_as_seller Deal[]        @relation("SellerDeals")
  deals_as_buyer  Deal[]        @relation("BuyerDeals")
  disputes_opened Dispute[]     @relation("DisputeOpener")
  evidence        Evidence[]

  @@index([email])
  @@index([line_sub])
}

model SellerProfile {
  id               String   @id @default(uuid())
  user_id          String   @unique
  verified         Boolean  @default(false)
  promptpay_id     String
  promptpay_name   String
  reputation_score Float    @default(0)
  kyc_status       String   @default("unverified") // 'unverified' | 'pending' | 'verified'
  created_at       DateTime @default(now())

  user              User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  reputation_events ReputationEvent[]

  @@index([verified])
  @@index([user_id])
}

model Deal {
  id              String    @id @default(uuid())
  title           String
  amount_satang   Int
  currency        String    @default("THB")
  seller_id       String
  buyer_id        String?
  status          String    @default("PENDING") // DealStatus enum
  paylink_token   String    @unique
  expires_at      DateTime
  tracking_number String?
  courier         String?
  delivered_at    DateTime?
  auto_release_at DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  seller   User       @relation("SellerDeals", fields: [seller_id], references: [id])
  buyer    User?      @relation("BuyerDeals", fields: [buyer_id], references: [id])
  payments Payment[]
  disputes Dispute[]
  events   DealEvent[]

  @@index([status])
  @@index([seller_id])
  @@index([buyer_id])
  @@index([paylink_token])
  @@index([auto_release_at])
}

model Payment {
  id           String    @id @default(uuid())
  deal_id      String
  provider     String    @default("mock_promptpay")
  provider_ref String    @unique
  status       String    @default("INIT") // 'INIT' | 'PAID' | 'REFUNDED' | 'FAILED'
  paid_at      DateTime?
  created_at   DateTime  @default(now())

  deal Deal @relation(fields: [deal_id], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([deal_id])
  @@index([provider_ref])
}

model Dispute {
  id              String    @id @default(uuid())
  deal_id         String
  opened_by       String
  reason_text     String
  status          String    @default("OPEN") // 'OPEN' | 'NEED_MORE_INFO' | 'RESOLVED_REFUND' | 'RESOLVED_RELEASE'
  resolution_note String?
  created_at      DateTime  @default(now())
  resolved_at     DateTime?

  deal     Deal       @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  opener   User       @relation("DisputeOpener", fields: [opened_by], references: [id])
  evidence Evidence[]

  @@index([status])
  @@index([deal_id])
  @@index([opened_by])
}

model Evidence {
  id          String   @id @default(uuid())
  dispute_id  String
  uploaded_by String
  kind        String   // 'image' | 'chatlog' | 'other'
  url         String
  note        String?
  created_at  DateTime @default(now())

  dispute  Dispute @relation(fields: [dispute_id], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploaded_by], references: [id])

  @@index([dispute_id])
}

model ReputationEvent {
  id        String   @id @default(uuid())
  seller_id String
  type      String   // 'positive' | 'neutral' | 'negative'
  weight    Float
  note      String?
  created_at DateTime @default(now())

  seller SellerProfile @relation(fields: [seller_id], references: [id], onDelete: Cascade)

  @@index([seller_id])
}

model DealEvent {
  id          String   @id @default(uuid())
  deal_id     String
  event_type  String   // audit trail: 'created', 'payment_received', 'shipped', etc.
  from_status String?
  to_status   String?
  actor_id    String?
  metadata    String?  @db.Text
  created_at  DateTime @default(now())

  deal Deal @relation(fields: [deal_id], references: [id], onDelete: Cascade)

  @@index([deal_id])
  @@index([created_at])
}
