generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  role         UserRole @default(buyer)
  line_sub     String?  @unique
  email        String   @unique
  phone        String?
  kyc_level    KYCLevel @default(none)
  display_name String
  created_at   DateTime @default(now())

  seller_profile   SellerProfile?
  deals_as_seller  Deal[]            @relation("SellerDeals")
  deals_as_buyer   Deal[]            @relation("BuyerDeals")
  disputes_opened  Dispute[]         @relation("DisputeOpener")
  evidence_uploads Evidence[]

  @@index([email])
  @@index([line_sub])
}

model SellerProfile {
  id               String    @id @default(uuid())
  user_id          String    @unique
  verified         Boolean   @default(false)
  promptpay_id     String?
  promptpay_name   String?
  reputation_score Float     @default(0)
  kyc_status       KYCStatus @default(unverified)
  created_at       DateTime  @default(now())

  user              User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  reputation_events ReputationEvent[]

  @@index([verified])
  @@index([user_id])
}

model Deal {
  id               String     @id @default(cuid())
  title            String
  amount_satang    Int
  currency         Currency   @default(THB)
  seller_id        String
  buyer_id         String?
  status           DealStatus @default(PENDING)
  paylink_token    String     @unique
  expires_at       DateTime
  tracking_number  String?
  courier          String?
  delivered_at     DateTime?
  auto_release_at  DateTime?
  buyer_note       String?
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt

  seller   User       @relation("SellerDeals", fields: [seller_id], references: [id])
  buyer    User?      @relation("BuyerDeals", fields: [buyer_id], references: [id])
  payments Payment[]
  disputes Dispute[]
  events   DealEvent[]

  @@index([status])
  @@index([seller_id])
  @@index([buyer_id])
  @@index([paylink_token])
  @@index([auto_release_at])
}

model Payment {
  id           String        @id @default(uuid())
  deal_id      String
  provider     String
  provider_ref String        @unique
  status       PaymentStatus @default(INIT)
  paid_at      DateTime?
  created_at   DateTime      @default(now())

  deal Deal @relation(fields: [deal_id], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([provider_ref])
  @@index([deal_id])
}

model Dispute {
  id              String        @id @default(uuid())
  deal_id         String
  opened_by       String
  reason          String
  reason_text     String
  status          DisputeStatus @default(OPEN)
  resolution_note String?
  created_at      DateTime      @default(now())
  resolved_at     DateTime?

  deal     Deal       @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  opener   User       @relation("DisputeOpener", fields: [opened_by], references: [id])
  evidence Evidence[]

  @@index([status])
  @@index([deal_id])
  @@index([created_at])
}

model Evidence {
  id          String   @id @default(uuid())
  dispute_id  String
  uploaded_by String
  kind        String
  url         String
  note        String?
  created_at  DateTime @default(now())

  dispute  Dispute @relation(fields: [dispute_id], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploaded_by], references: [id])

  @@index([dispute_id])
}

model ReputationEvent {
  id        String   @id @default(uuid())
  seller_id String
  type      String
  weight    Float
  note      String?
  created_at DateTime @default(now())

  seller SellerProfile @relation(fields: [seller_id], references: [id], onDelete: Cascade)

  @@index([seller_id])
}

model DealEvent {
  id         String   @id @default(uuid())
  deal_id    String
  event_type String
  actor_id   String?
  metadata   Json?
  created_at DateTime @default(now())

  deal Deal @relation(fields: [deal_id], references: [id], onDelete: Cascade)

  @@index([deal_id])
  @@index([created_at])
}

enum UserRole {
  buyer
  seller
  admin
}

enum KYCLevel {
  none
  basic
  full
}

enum KYCStatus {
  unverified
  pending
  verified
}

enum Currency {
  THB
}

enum DealStatus {
  PENDING
  HOLD
  SHIPPED
  RELEASED
  DISPUTE
  REFUND
}

enum PaymentStatus {
  INIT
  PAID
  REFUNDED
  FAILED
}

enum DisputeStatus {
  OPEN
  NEED_MORE_INFO
  RESOLVED_REFUND
  RESOLVED_RELEASE
}
