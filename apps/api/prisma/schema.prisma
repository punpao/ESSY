// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  role        String   @default("buyer") // buyer | seller | admin
  line_sub    String?  @unique
  email       String   @unique
  phone       String?
  kyc_level   String   @default("none") // none | basic | full
  display_name String
  created_at  DateTime @default(now())

  seller_profile SellerProfile?
  deals_as_seller Deal[] @relation("DealSeller")
  deals_as_buyer Deal[] @relation("DealBuyer")
  disputes_opened Dispute[]
  evidence_uploads Evidence[]
  reputation_events ReputationEvent[]

  @@index([email])
  @@index([line_sub])
  @@map("users")
}

model SellerProfile {
  id              String   @id @default(uuid())
  user_id         String   @unique
  verified        Boolean  @default(false)
  promptpay_id    String
  promptpay_name  String
  reputation_score Float   @default(0)
  kyc_status      String   @default("unverified") // unverified | pending | verified

  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  deals           Deal[]
  reputation_events ReputationEvent[]

  @@index([verified])
  @@index([kyc_status])
  @@map("seller_profiles")
}

model Deal {
  id              String   @id @default(uuid())
  title           String
  amount_satang   Int
  currency        String   @default("THB")
  seller_id       String
  buyer_id        String?
  status          String   // PENDING | HOLD | SHIPPED | RELEASED | DISPUTE | REFUND
  paylink_token   String   @unique
  expires_at      DateTime
  tracking_number String?
  courier         String?
  delivered_at    DateTime?
  auto_release_at DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  seller          User     @relation("DealSeller", fields: [seller_id], references: [id])
  buyer           User?    @relation("DealBuyer", fields: [buyer_id], references: [id])
  seller_profile  SellerProfile @relation(fields: [seller_id], references: [user_id])
  payments        Payment[]
  disputes        Dispute[]

  @@index([status])
  @@index([seller_id])
  @@index([buyer_id])
  @@index([paylink_token])
  @@index([auto_release_at])
  @@map("deals")
}

model Payment {
  id           String   @id @default(uuid())
  deal_id      String
  provider     String   // mock_promptpay
  provider_ref String
  status       String   // INIT | PAID | REFUNDED | FAILED
  paid_at      DateTime?

  deal         Deal     @relation(fields: [deal_id], references: [id], onDelete: Cascade)

  @@index([deal_id])
  @@index([status])
  @@index([provider_ref])
  @@map("payments")
}

model Dispute {
  id             String    @id @default(uuid())
  deal_id        String
  opened_by      String
  reason_text    String
  status         String    @default("OPEN") // OPEN | NEED_MORE_INFO | RESOLVED_REFUND | RESOLVED_RELEASE
  resolution_note String?
  created_at     DateTime  @default(now())
  resolved_at    DateTime?

  deal           Deal      @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  opener         User      @relation(fields: [opened_by], references: [id])
  evidence       Evidence[]

  @@index([deal_id])
  @@index([status])
  @@index([opened_by])
  @@map("disputes")
}

model Evidence {
  id          String   @id @default(uuid())
  dispute_id  String
  uploaded_by String
  kind        String   // image | chatlog | other
  url         String
  note        String?

  dispute     Dispute  @relation(fields: [dispute_id], references: [id], onDelete: Cascade)
  uploader    User     @relation(fields: [uploaded_by], references: [id])

  created_at  DateTime @default(now())

  @@index([dispute_id])
  @@map("evidence")
}

model ReputationEvent {
  id          String   @id @default(uuid())
  seller_id   String
  type        String   // positive | neutral | negative
  weight      Float
  note        String?

  seller      User     @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  seller_profile SellerProfile @relation(fields: [seller_id], references: [user_id])

  created_at  DateTime @default(now())

  @@index([seller_id])
  @@map("reputation_events")
}
