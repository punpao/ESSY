// Prisma schema for Thai Social-Commerce Escrow Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== USER & AUTH =====

model User {
  id          String   @id @default(uuid())
  role        UserRole @default(buyer)
  lineSub     String?  @unique @map("line_sub")
  email       String   @unique
  phone       String?
  kycLevel    KycLevel @default(none) @map("kyc_level")
  displayName String   @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")

  sellerProfile SellerProfile?
  dealsAsSeller Deal[]             @relation("SellerDeals")
  dealsAsBuyer  Deal[]             @relation("BuyerDeals")
  disputes      Dispute[]
  evidence      Evidence[]

  @@index([email])
  @@index([lineSub])
  @@map("users")
}

enum UserRole {
  buyer
  seller
  admin
}

enum KycLevel {
  none
  basic
  full
}

// ===== SELLER PROFILE =====

model SellerProfile {
  id              String    @id @default(uuid())
  userId          String    @unique @map("user_id")
  verified        Boolean   @default(false)
  promptpayId     String?   @map("promptpay_id")
  promptpayName   String?   @map("promptpay_name")
  reputationScore Float     @default(50.0) @map("reputation_score")
  kycStatus       KycStatus @default(unverified) @map("kyc_status")
  createdAt       DateTime  @default(now()) @map("created_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reputationEvents ReputationEvent[]

  @@index([verified])
  @@index([userId])
  @@map("seller_profiles")
}

enum KycStatus {
  unverified
  pending
  verified
}

// ===== DEAL / ESCROW =====

model Deal {
  id             String     @id @default(uuid())
  title          String
  amountSatang   Int        @map("amount_satang")
  currency       Currency   @default(THB)
  sellerId       String     @map("seller_id")
  buyerId        String?    @map("buyer_id")
  status         DealStatus @default(PENDING)
  paylinkToken   String     @unique @map("paylink_token")
  expiresAt      DateTime   @map("expires_at")
  trackingNumber String?    @map("tracking_number")
  courier        String?
  deliveredAt    DateTime?  @map("delivered_at")
  autoReleaseAt  DateTime?  @map("auto_release_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  seller   User      @relation("SellerDeals", fields: [sellerId], references: [id])
  buyer    User?     @relation("BuyerDeals", fields: [buyerId], references: [id])
  payments Payment[]
  disputes Dispute[]
  events   DealEvent[]

  @@index([status])
  @@index([sellerId])
  @@index([buyerId])
  @@index([paylinkToken])
  @@index([autoReleaseAt])
  @@map("deals")
}

enum DealStatus {
  PENDING
  HOLD
  SHIPPED
  RELEASED
  DISPUTE
  REFUND
}

enum Currency {
  THB
}

// ===== DEAL EVENTS (Audit Trail) =====

model DealEvent {
  id        String   @id @default(uuid())
  dealId    String   @map("deal_id")
  eventType String   @map("event_type")
  fromState String?  @map("from_state")
  toState   String   @map("to_state")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([createdAt])
  @@map("deal_events")
}

// ===== PAYMENT =====

model Payment {
  id          String        @id @default(uuid())
  dealId      String        @map("deal_id")
  provider    String        @default("mock_promptpay")
  providerRef String        @unique @map("provider_ref")
  status      PaymentStatus @default(INIT)
  paidAt      DateTime?     @map("paid_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([dealId])
  @@index([providerRef])
  @@map("payments")
}

enum PaymentStatus {
  INIT
  PAID
  REFUNDED
  FAILED
}

// ===== DISPUTE =====

model Dispute {
  id             String        @id @default(uuid())
  dealId         String        @map("deal_id")
  openedBy       String        @map("opened_by")
  reasonText     String        @map("reason_text")
  status         DisputeStatus @default(OPEN)
  resolutionNote String?       @map("resolution_note")
  createdAt      DateTime      @default(now()) @map("created_at")
  resolvedAt     DateTime?     @map("resolved_at")

  deal     Deal       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  opener   User       @relation(fields: [openedBy], references: [id])
  evidence Evidence[]

  @@index([status])
  @@index([dealId])
  @@index([createdAt])
  @@map("disputes")
}

enum DisputeStatus {
  OPEN
  NEED_MORE_INFO
  RESOLVED_REFUND
  RESOLVED_RELEASE
}

// ===== EVIDENCE =====

model Evidence {
  id         String       @id @default(uuid())
  disputeId  String       @map("dispute_id")
  uploadedBy String       @map("uploaded_by")
  kind       EvidenceKind
  url        String
  note       String?
  createdAt  DateTime     @default(now()) @map("created_at")

  dispute  Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploadedBy], references: [id])

  @@index([disputeId])
  @@map("evidence")
}

enum EvidenceKind {
  image
  chatlog
  other
}

// ===== REPUTATION =====

model ReputationEvent {
  id        String              @id @default(uuid())
  sellerId  String              @map("seller_id")
  type      ReputationEventType
  weight    Float
  note      String?
  createdAt DateTime            @default(now()) @map("created_at")

  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@map("reputation_events")
}

enum ReputationEventType {
  positive
  neutral
  negative
}
