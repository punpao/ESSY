{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "declaration": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@escrow/core": ["../../packages/core/src"],
      "@escrow/core/*": ["../../packages/core/src/*"],
      "@escrow/payment": ["../../packages/payment/src"],
      "@escrow/payment/*": ["../../packages/payment/src/*"]
    }
  },
  "include": ["src", "prisma"],
  "exclude": ["dist", "node_modules"]
}
