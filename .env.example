# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/escrow

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=change_me_to_secure_random_string

# LINE OAuth (for production, get from LINE Developers)
LINE_CHANNEL_ID=demo
