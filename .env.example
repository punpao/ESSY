# App
APP_BASE_URL=http://localhost:3000
PORT=3001

# Payment
PAYMENT_WEBHOOK_SECRET=mock_secret

# Auto-release
AUTO_RELEASE_HOURS=48

# Public API URL (for frontend)
NEXT_PUBLIC_API_URL=http://localhost:3001
